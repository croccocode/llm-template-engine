#!/usr/bin/env bash

set -e

# load utility functions, keep as first import
# utilities functions are for logging (instead of using `echo`, call `log`, it prints the line number)
# or check that `everything-is-committed` before deploy 
source ./functions.sh

# Write your own functions in this file or in separate files. 
# This script loads any file called `shMakefile` recursively from the current path.
# Handy in a monorepo, where each service has its own folder. This way it is possible to declare 
# service-based functions in the same scope of the service (@see the func `turbodeploy` later on).
shopt -s globstar
for f in ./**/shMakefile; do
  # skip myself
  [[ "$f" == "./shMakefile" ]] && continue
  # skip the examples in the project repo
  [[ "$f" == ./examples/* ]] && continue
  # shellcheck source=/dev/null
  source "$f"
done
